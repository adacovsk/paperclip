{
  "name": "paperclip",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs watch",
    "dev:watch": "node scripts/dev-runner.mjs watch",
    "dev:once": "node scripts/dev-runner.mjs dev",
    "dev:server": "pnpm --filter @paperclipai/server dev",
    "serve": "pnpm --filter @paperclipai/server serve",
    "deploy:live": "./scripts/deploy.sh",
    "dev:ui": "pnpm --filter @paperclipai/ui dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "pnpm --filter @paperclipai/db generate",
    "db:migrate": "pnpm --filter @paperclipai/db migrate",
    "secrets:migrate-inline-env": "tsx scripts/migrate-inline-env-secrets.ts",
    "db:backup": "./scripts/backup-db.sh",
    "paperclipai": "node cli/node_modules/tsx/dist/cli.mjs cli/src/index.ts",
    "check:tokens": "node scripts/check-forbidden-tokens.mjs",
    "check:agent-git": "node scripts/check-agent-git-predicates.mjs",
    "check:agent-privacy": "node scripts/check-agent-privacy.mjs",
    "check:agent-rationale": "node scripts/check-agent-rationale.mjs",
    "docs:dev": "cd docs && pnpm dlx mintlify@4.3.18 dev",
    "smoke:openclaw-join": "./scripts/smoke/openclaw-join.sh",
    "smoke:openclaw-docker-ui": "./scripts/smoke/openclaw-docker-ui.sh",
    "smoke:openclaw-sse-standalone": "./scripts/smoke/openclaw-sse-standalone.sh",
    "test:e2e": "pnpm exec playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:headed": "pnpm exec playwright test --config tests/e2e/playwright.config.ts --headed",
    "evals:smoke": "cd evals/promptfoo && pnpm dlx promptfoo@0.103.3 eval"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.19.0"
}
